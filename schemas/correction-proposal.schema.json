{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-context-broker.invalid/schemas/agent-context/correction-proposal.schema.json",
  "title": "Agent Context Broker Correction Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "proposalKey", "targetRef", "targetRevisionHash",
    "correctionKind", "disposition", "replacementHash", "evidenceRefs",
    "confidence", "scope", "requestedBy", "approvalClass", "sensitivity",
    "occurredAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "proposalKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "targetRef": { "type": "string", "pattern": "^acb://[a-z][a-z0-9-]*/[a-f0-9]{64}$" },
    "targetRevisionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "correctionKind": { "enum": ["finding", "guidance", "claim"] },
    "disposition": { "enum": ["replace", "withdraw", "refresh"] },
    "replacementHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^acb://[a-z][a-z0-9-]*/[a-f0-9]{64}$" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "keyHash"],
      "properties": {
        "kind": { "enum": ["global", "project", "workstream", "ticket", "merge-request"] },
        "keyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "requestedBy": { "enum": ["codex", "claude-code"] },
    "approvalClass": { "enum": ["auto-private", "owner-validated", "explicit"] },
    "sensitivity": { "enum": ["shared", "private"] },
    "occurredAt": { "type": "string", "format": "date-time" }
  }
}
