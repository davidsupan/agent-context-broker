{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-context-broker.invalid/schemas/agent-context/context-claim.schema.json",
  "title": "Accepted Agent Context Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "claimId", "claimKey", "claimType", "subject",
    "predicate", "value", "valueHash", "observedAt", "acceptedAt",
    "confidence", "sensitivity", "status", "supersedes", "canonicalRefs",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "claimId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "claimKey": { "type": "string", "minLength": 1 },
    "claimType": { "enum": ["fact", "decision", "procedure", "risk", "result"] },
    "subject": { "type": "string", "minLength": 1 },
    "predicate": { "type": "string", "minLength": 1 },
    "value": {},
    "valueHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "observedAt": { "type": "string", "format": "date-time" },
    "acceptedAt": { "type": "string", "format": "date-time" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "sensitivity": { "enum": ["shared", "private"] },
    "status": { "const": "accepted" },
    "freshness": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["policy", "verifiedAt", "expiresAt", "sourceHeadHash"],
      "properties": {
        "policy": { "enum": ["immutable", "ttl", "canonical-head", "manual"] },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" },
        "sourceHeadHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "supersedes": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "canonicalRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "sessionKey", "recordKey", "sourceHash"],
        "properties": {
          "provider": { "enum": ["codex", "claude-code"] },
          "sessionKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "recordKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
