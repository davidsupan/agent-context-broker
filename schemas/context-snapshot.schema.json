{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-context-broker.invalid/schemas/agent-context/context-snapshot.schema.json",
  "title": "Accepted Agent Context Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "snapshotId", "version", "baseSnapshotHash", "scope",
    "createdAt", "claimIds", "relationKeys", "canonicalRefs", "state",
    "snapshotHash", "digest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "snapshotId": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "baseSnapshotHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "key"],
      "properties": {
        "kind": { "enum": ["global", "project", "workstream", "ticket", "merge-request"] },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "claimIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "relationKeys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "canonicalRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "state": { "const": "clean" },
    "snapshotHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
