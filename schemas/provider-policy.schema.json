{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-context-broker.invalid/schemas/agent-context/provider-policy.schema.json",
  "title": "Agent Context Broker provider policy",
  "description": "Optional operator policy that narrows what each provider may read and publish. Without the file every provider keeps the default behaviour.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "providers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codex": { "$ref": "#/$defs/provider" },
        "claude-code": { "$ref": "#/$defs/provider" }
      }
    }
  },
  "$defs": {
    "pattern": {
      "type": "string",
      "description": "<kind>:<key glob>. Kind is global, project, workstream, ticket, merge-request or *. The key glob matches case-insensitively and * matches any characters.",
      "pattern": "^(?:\\*|global|project|workstream|ticket|merge-request):[^\\s\\u0000]{1,200}$"
    },
    "patterns": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/pattern" }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "teamShared": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxContextBytes": { "type": "integer", "minimum": 0, "maximum": 65536, "default": 2048,
              "description": "Notice injection lane cap including its header and envelopes, further limited to one quarter of the selected profile budget." }
          }
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "teamShared": { "enum": ["allow", "deny"], "default": "deny" }
          }
        },
        "strictIsolation": {
          "type": "boolean",
          "description": "When true the provider receives no context and may not publish, as AGENT_CONTEXT_BROKER_STRICT_ISOLATION=1 does for every provider."
        },
        "defaultProject": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "description": "Replaces AGENT_CONTEXT_BROKER_DEFAULT_PROJECT for this provider's hooks. null means no ambient project."
        },
        "read": {
          "type": "object",
          "additionalProperties": false,
          "description": "With allow present, only matching scopes are readable. deny always wins. Read rules also stop related-scope expansion, because related scopes are recorded as hashes.",
          "properties": {
            "allow": { "$ref": "#/$defs/patterns" },
            "deny": { "$ref": "#/$defs/patterns" }
          }
        },
        "publish": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow": { "$ref": "#/$defs/patterns" },
            "deny": { "$ref": "#/$defs/patterns" },
            "maxSensitivity": { "enum": ["shared", "private", "restricted"] },
            "evidenceClasses": {
              "type": "array",
              "items": { "enum": ["canonical-artifact", "observed-tool-result", "agent-handoff"] }
            }
          }
        }
      }
    }
  }
}
