{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-context-broker.invalid/schemas/agent-context/broker-event.schema.json",
  "title": "Agent Context Broker Lifecycle Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "eventId", "idempotencyKey", "sequence", "eventType",
    "occurredAt", "recordedAt", "provider", "scope", "taskKeyHash",
    "threadKey", "sourceRefs", "subjectRef", "replacesRef", "evidenceRefs",
    "confidence", "freshness", "sensitivity", "redactionResult",
    "approvalState", "payload", "payloadHash", "previousEventHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "idempotencyKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "eventType": {
      "enum": [
        "source.inventoryed", "thread.delta", "claim.proposed",
        "claim.accepted", "claim.rejected", "claim.superseded",
        "snapshot.published", "correction.proposed", "correction.accepted",
        "correction.rejected", "usage.observed", "read-model.projected",
        "peer-progress.published"
      ]
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "provider": { "enum": ["system", "codex", "claude-code"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "keyHash"],
      "properties": {
        "kind": { "enum": ["global", "project", "workstream", "ticket", "merge-request"] },
        "keyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "taskKeyHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "threadKey": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "sourceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^acb://[a-z][a-z0-9-]*/[a-f0-9]{64}$" }
    },
    "subjectRef": { "type": "string", "pattern": "^acb://[a-z][a-z0-9-]*/[a-f0-9]{64}$" },
    "replacesRef": { "type": ["string", "null"], "pattern": "^acb://[a-z][a-z0-9-]*/[a-f0-9]{64}$" },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^acb://[a-z][a-z0-9-]*/[a-f0-9]{64}$" }
    },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "verifiedAt", "expiresAt", "sourceHeadHash", "policy"],
      "properties": {
        "status": { "enum": ["current", "stale", "expired", "unknown"] },
        "verifiedAt": { "type": ["string", "null"], "format": "date-time" },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" },
        "sourceHeadHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "policy": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$" }
      }
    },
    "sensitivity": { "enum": ["shared", "private"] },
    "redactionResult": { "enum": ["clean", "suppressed"] },
    "approvalState": { "enum": ["not-required", "pending", "approved", "rejected"] },
    "payload": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "integer", "number", "boolean", "null"]
      }
    },
    "payloadHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "previousEventHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
  }
}
