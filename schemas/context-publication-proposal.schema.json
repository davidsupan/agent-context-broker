{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-context-broker.invalid/schemas/context-publication-proposal.schema.json",
  "title": "Context publication proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "proposalId", "sourceToken", "scope", "claims"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "proposalId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "sourceToken": { "type": "string", "pattern": "^acb://source/[a-f0-9]{64}$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "key"],
      "properties": {
        "kind": { "enum": ["global", "project", "workstream", "ticket", "merge-request"] },
        "key": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claimKey", "claimType", "subject", "predicate", "value",
          "observedAt", "confidence", "sensitivity", "evidenceClass",
          "verification", "canonicalRefs"
        ],
        "properties": {
          "claimKey": { "type": "string", "minLength": 1 },
          "claimType": { "enum": ["fact", "decision", "procedure", "question", "risk", "hypothesis", "write", "result"] },
          "subject": { "type": "string", "minLength": 1 },
          "predicate": { "type": "string", "minLength": 1 },
          "value": {},
          "observedAt": { "type": "string", "format": "date-time" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "sensitivity": { "enum": ["shared", "private", "restricted"] },
          "evidenceClass": { "enum": ["canonical-artifact", "observed-tool-result", "agent-handoff"] },
          "verification": { "enum": ["verified", "unverified"] },
          "freshness": { "$ref": "freshness.schema.json" },
          "canonicalRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
