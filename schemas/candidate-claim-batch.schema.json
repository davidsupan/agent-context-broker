{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-context-broker.invalid/schemas/agent-context/candidate-claim-batch.schema.json",
  "title": "Agent Context Candidate Claim Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "batchId", "expectedSnapshotHash", "scope", "relationKeys", "claims"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "batchId": { "type": "string", "minLength": 1 },
    "expectedSnapshotHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "key"],
      "properties": {
        "kind": { "enum": ["global", "project", "workstream", "ticket", "merge-request"] },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "relationKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}:[a-f0-9]{64}$" }
    },
    "claims": {
      "type": "array",
      "description": "Claim keys must be unique within one batch.",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claimKey", "claimType", "subject", "predicate", "value",
          "observedAt", "confidence", "sensitivity", "evidenceClass",
          "verification", "expectedCurrentClaimId", "canonicalRefs", "provenance"
        ],
        "properties": {
          "claimKey": { "type": "string", "minLength": 1 },
          "claimType": { "enum": ["fact", "decision", "procedure", "question", "risk", "hypothesis", "write", "result"] },
          "subject": { "type": "string", "minLength": 1 },
          "predicate": { "type": "string", "minLength": 1 },
          "value": {},
          "observedAt": { "type": "string", "format": "date-time" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "sensitivity": { "enum": ["shared", "private", "restricted"] },
          "evidenceClass": { "enum": ["canonical-artifact", "observed-tool-result", "agent-handoff"] },
          "verification": { "enum": ["verified", "unverified"] },
          "freshness": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["policy", "verifiedAt", "expiresAt", "sourceHeadHash"],
            "properties": {
              "policy": { "enum": ["immutable", "ttl", "canonical-head", "manual"] },
              "verifiedAt": { "type": "string", "format": "date-time" },
              "expiresAt": { "type": ["string", "null"], "format": "date-time" },
              "sourceHeadHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
            }
          },
          "expectedCurrentClaimId": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "canonicalRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider", "sessionKey", "recordKey", "sourceHash"],
              "properties": {
                "provider": { "enum": ["codex", "claude-code"] },
                "sessionKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "recordKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
