{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-context-broker.invalid/schemas/agent-context/context-profile.schema.json",
  "title": "Agent Context Query Profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "description", "taskKinds", "keywords", "claimTypes",
          "crossProvider", "maxSnapshots", "maxClaims", "maxValueBytes",
          "maxContextBytes"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "description": { "type": "string", "minLength": 1 },
          "taskKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "keywords": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "claimTypes": { "type": "array", "uniqueItems": true, "items": { "enum": ["fact", "decision", "procedure", "risk", "result"] } },
          "crossProvider": { "type": "boolean" },
          "maxSnapshots": { "type": "integer", "minimum": 0, "maximum": 20 },
          "maxClaims": { "type": "integer", "minimum": 0, "maximum": 100 },
          "maxValueBytes": { "type": "integer", "minimum": 0, "maximum": 65536 },
          "maxContextBytes": { "type": "integer", "minimum": 256, "maximum": 65536 }
        }
      }
    }
  }
}
