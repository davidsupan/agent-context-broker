{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-context-broker.invalid/schemas/agent-context/read-model-node.schema.json",
  "title": "Agent Context Broker Read Model Node",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "kind", "status", "freshness", "provider",
    "sensitivity", "latestSequence", "latestEventId", "attributesHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^acb://[a-z][a-z0-9-]*/[a-f0-9]{64}$" },
    "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "status": { "enum": ["observed", "pending", "accepted", "rejected", "superseded", "published", "live-unverified"] },
    "freshness": { "enum": ["current", "stale", "expired", "unknown"] },
    "provider": { "enum": ["system", "codex", "claude-code"] },
    "sensitivity": { "enum": ["shared", "private"] },
    "latestSequence": { "type": "integer", "minimum": 1 },
    "latestEventId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "attributesHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
