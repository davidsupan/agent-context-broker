{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-context-broker.invalid/schemas/agent-context/correction-decision.schema.json",
  "title": "Agent Context Broker Correction Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "correctionRef", "expectedProposalEventId", "decision",
    "observedRevisionHash", "evidenceRefs", "decidedBy", "occurredAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "correctionRef": { "type": "string", "pattern": "^acb://correction/[a-f0-9]{64}$" },
    "expectedProposalEventId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decision": { "enum": ["accept", "reject"] },
    "observedRevisionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^acb://[a-z][a-z0-9-]*/[a-f0-9]{64}$" }
    },
    "decidedBy": { "enum": ["codex", "claude-code"] },
    "occurredAt": { "type": "string", "format": "date-time" }
  }
}
