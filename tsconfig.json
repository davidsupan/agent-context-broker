{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "types": ["node"]
  },
  "include": ["src/**/*.mjs", "providers/**/*.mjs", "scripts/**/*.mjs", "adapters/**/*.mjs"],
  "exclude": ["node_modules", "**/test/**", "runtime"]
}
